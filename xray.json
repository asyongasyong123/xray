{
  "log": {
    "loglevel": "warning",
    "access": "none",
    "error": "none"
  },
  "dns": {
    "servers": ["8.8.8.8", "8.8.4.4"],
    "strategy": "UseIPv4"
  },
  "policy": {
    "levels": {
      "0": {
        "handshake": 2,
        "connIdle": 300,
        "uplinkOnly": 0,
        "downlinkOnly": 0,
        "bufferSize": 4096
      }
    }
  },
  "inbounds": [
    {
      "port": 10001,
      "listen": "127.0.0.1",
      "protocol": "trojan",
      "tag": "trojan-ws",
      "settings": {
        "clients": [{"password": "xray-2026", "level": 0}]
      },
      "sniffing": {
        "enabled": false
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/tr-ws-xray",
          "maxEarlyData": 2560,
          "earlyDataHeaderName": ""
        },
        "sockopt": {
          "tcpNoDelay": true,
          "tcpKeepAlive": true,
          "tcpKeepAliveIdle": 15,
          "tcpKeepAliveInterval": 8,
          "tcpKeepAliveProbes": 3,
          "tcpcongestion": "bbr"
        }
      }
    },
    {
      "port": 10002,
      "listen": "127.0.0.1",
      "protocol": "vless",
      "tag": "vless-ws",
      "settings": {
        "clients": [{"id": "a7b2c9d4-1e3f-4a5b-8c9d-0e1f2a3b4c5d", "level": 0}],
        "decryption": "none"
      },
      "sniffing": {
        "enabled": false
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/vl-ws-xray",
          "maxEarlyData": 2560,
          "earlyDataHeaderName": ""
        },
        "sockopt": {
          "tcpNoDelay": true,
          "tcpKeepAlive": true,
          "tcpKeepAliveIdle": 15,
          "tcpKeepAliveInterval": 8,
          "tcpKeepAliveProbes": 3,
          "tcpcongestion": "bbr"
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct",
      "settings": {"domainStrategy": "UseIPv4"}
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {"type": "Field", "inboundTag": ["trojan-ws", "vless-ws"], "outboundTag": "direct"}
    ]
  }
}
